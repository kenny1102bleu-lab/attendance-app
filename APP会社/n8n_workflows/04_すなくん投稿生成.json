{
  "name": "KCS_Phase4_すなくん投稿生成",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "hours", "hoursInterval": 24, "triggerAtHour": 12 },
            { "field": "hours", "hoursInterval": 24, "triggerAtHour": 19 },
            { "field": "hours", "hoursInterval": 24, "triggerAtHour": 22 }
          ]
        }
      },
      "name": "1日3回スケジュール",
      "type": "n8n-nodes-base.scheduleTrigger",
