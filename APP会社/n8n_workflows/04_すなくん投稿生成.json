      "name": "GAS_すなくん投稿生成",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300],
      "_comment": "GASがClaude Haikuで投稿文を生成 → 楽天トレンド商品を参照 → #affiliateチャンネルに通知"
    }
  ],
  "connections": {
    "1日3回スケジュール": { "main": [[{ "node": "GAS_すなくん投稿生成", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "_comment": "RAKUTEN_APP_ID が設定されていれば楽天トレンドを参照。未設定でもテーマベースで生成。3回に1回 @HAL の紹介を含む。"
}
