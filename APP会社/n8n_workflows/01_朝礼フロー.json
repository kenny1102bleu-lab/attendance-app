{
  "name": "KCS_Phase2_定期投稿フロー",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 3 }] }
      },
      "name": "3時間ごとのトリガー",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "={{$env.KCS_GAS_URL}}",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [{ "name": "action", "value": "morning_briefing" }]
        },
        "options": {}
      },
      "name": "GAS_アフィリエイト生成実行",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300]
    }
  ],
  "connections": {
    "3時間ごとのトリガー": { "main": [[{ "node": "GAS_アフィリエイト生成実行", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "_comment": "GAS_KCS合同会社_Backend.gs の morningBriefing() を呼び出す。GASが Discordに投稿案を送信する。3時間ごとに実行される。"
}
